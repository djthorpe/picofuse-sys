prefix=${pcfiledir}/@PICOFUSE_PC_PREFIX_REL@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
PICOFUSE_ARMGNU=@PICOFUSE_ARMGNU@
PICOFUSE_CPU=@PICOFUSE_CPU@
PICOFUSE_CHIP_DIR=@PICOFUSE_CHIP_DIR@
PICOFUSE_FAMILY=@PICOFUSE_FAMILY@
PICOFUSE_SRAM_ENTRY=@PICOFUSE_SRAM_ENTRY@
PICOFUSE_SRAM_LOAD=@PICOFUSE_SRAM_LOAD@
PICOFUSE_FLASH_ENTRY=@PICOFUSE_FLASH_ENTRY@
PICOFUSE_FLASH_LOAD=@PICOFUSE_FLASH_LOAD@

Name: picofuse-sys
Description: Picofuse hardware/system/device abstraction library
Version: @PICOFUSE_PC_VERSION@
Libs: -L${libdir} -l@PICOFUSE_PC_LIB_NAME@
Cflags: -I${includedir}
